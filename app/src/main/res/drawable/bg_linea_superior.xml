<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ NUEVO (14-nov, Jorge): solo una línea arriba (1 dp, azul rey) para separar filas de F1:
     el borde de los otros tres lados queda fuera de la vista y el relleno es transparente. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-2dp" android:right="-2dp" android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1F3FA6" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
