<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo: Borde blanco -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/holo_green_light" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- border -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="1.5dp">

        <!--inicio del vector completo donde esta el vector del icono -->

        <vector
            android:width="170dp"
            android:height="170dp"
            android:viewportWidth="70"
            android:viewportHeight="70"
            android:tint="#8607C5">
            <group android:scaleX="3.2625"
                android:scaleY="3.2625"
                android:translateX="-4.5"
                android:translateY="-4.5">

                <!--inicio icono propiamente dicho -->

                <path android:fillColor="@android:color/white" android:pathData="M17,3L5,3c-1.11,0 -2,0.9 -2,2v14c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2L21,7l-4,-4zM12,19c-1.66,0 -3,-1.34 -3,-3s1.34,-3 3,-3 3,1.34 3,3 -1.34,3 -3,3zM15,9L5,9L5,5h10v4z"/>

                <!--fin icono propiamente dicho -->


            </group>
            <solid android:color="@android:color/white" />
            <stroke android:color="@android:color/black" android:width="1dp" />
        </vector>

        <!--fin vector original -->

    </item>
</layer-list>
