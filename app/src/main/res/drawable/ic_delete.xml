<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo: Borde blanco -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/holo_green_light" />
            <corners android:radius="5dp" />
        </shape>
    </item>
<!-- border -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="1.5dp">

        <!--inicio del vector completo donde esta el vector del icono -->

        <vector
            android:width="170dp"
            android:height="170dp"
            android:viewportWidth="55"
            android:viewportHeight="65"
            android:tint="@android:color/holo_red_light">
            <group android:scaleX="3.2625"
                android:scaleY="3.2625"
                android:translateX="-11.85"
                android:translateY="-6.85">

                <!--inicio icono propiamente dicho -->

                <path
                    android:fillColor="@android:color/white"
                    android:pathData="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"/>

                <!--fin icono propiamente dicho -->


            </group>
            <solid android:color="@android:color/white" />
            <stroke android:color="@android:color/black" android:width="1dp" />
        </vector>

        <!--fin vector original -->

    </item>
</layer-list>
