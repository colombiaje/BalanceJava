<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo: Borde blanco -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/holo_green_light" />
            <corners android:radius="5dp" />
        </shape>
    </item>
<!-- border -->
    <item android:left="5dp" android:right="5dp" android:top="5dp" android:bottom="5dp">

        <!--inicio del vector completo donde esta el vector del icono -->

        <vector
            android:width="170dp"
            android:height="170dp"
            android:viewportWidth="55"
            android:viewportHeight="65"
            android:tint="#03A9F4">
            <group android:scaleX="3.2625"
                android:scaleY="3.2625"
                android:translateX="-13.85"
                android:translateY="-2.85">

                <!--inicio icono propiamente dicho -->

                <path
                    android:fillColor="@android:color/white"
                    android:pathData="M3,17.25V21h3.75L17.81,9.94l-3.75,-3.75L3,17.25zM20.71,7.04c0.39,-0.39 0.39,-1.02 0,-1.41l-2.34,-2.34c-0.39,-0.39 -1.02,-0.39 -1.41,0l-1.83,1.83 3.75,3.75 1.83,-1.83z"/>

                <!--fin icono propiamente dicho -->

            </group>
            <solid android:color="@android:color/white" />
            <stroke android:color="@android:color/black" android:width="1dp" />
        </vector>

        <!--fin vector original -->

    </item>
</layer-list>
