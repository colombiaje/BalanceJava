<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ NUEVO (16-nov, Jorge): opciones de menú que ejecutan un proceso (Backups y cierre en F2,
     Tipos de cierre en F4). Mismo verde de los botones de acción; al tocar se oscurece. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#5E7A12" />
            <solid android:color="#7FA31B" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_boton_accion" />
</selector>
