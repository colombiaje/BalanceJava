<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout completo de calculadora F91 con diseño Material Design
    Archivo: res/layout/f91_calculadora.xml

    Estructura:
    - CardView (contenedor con elevación)
      - LinearLayout vertical
        - TextView (display de resultados)
        - GridLayout 4x5 (20 botones de calculadora)
        - LinearLayout horizontal (botones de acción)
-->

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ==================== DISPLAY DE RESULTADOS ==================== -->
        <TextView
            android:id="@+id/resultado_XTv"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="0"
            android:textSize="30sp"
            android:textColor="#212121"
            android:gravity="center_vertical|end"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#F5F5F5"
            android:fontFamily="sans-serif-light"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"/>

        <!-- ==================== TECLADO NUMÉRICO ==================== -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="false"
            android:layout_marginBottom="12dp">

            <!-- ==================== FILA 1: AC | ← | % | ÷ ==================== -->

            <Button
                android:id="@+id/bLimp_XBt"
                style="@style/CalculadoraBotonFuncion"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="AC"
                android:textColor="#FF5252"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/bRetroceso_XBt"
                style="@style/CalculadoraBotonFuncion"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="⌫"
                android:textSize="28sp"/>

            <Button
                android:id="@+id/bPorcentaje_XBt"
                style="@style/CalculadoraBotonFuncion"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:text="%"/>

            <Button
                android:id="@+id/bDivision_XBt"
                style="@style/CalculadoraBotonOperador"
                android:layout_row="0"
                android:layout_column="3"
                android:layout_columnWeight="1"
                android:text="÷"/>

            <!-- ==================== FILA 2: 7 | 8 | 9 | × ==================== -->

            <Button
                android:id="@+id/b7_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="7"/>

            <Button
                android:id="@+id/b8_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="8"/>

            <Button
                android:id="@+id/b9_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:text="9"/>

            <Button
                android:id="@+id/bPor_XBt"
                style="@style/CalculadoraBotonOperador"
                android:layout_row="1"
                android:layout_column="3"
                android:layout_columnWeight="1"
                android:text="×"/>

            <!-- ==================== FILA 3: 4 | 5 | 6 | − ==================== -->

            <Button
                android:id="@+id/b4_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="4"/>

            <Button
                android:id="@+id/b5_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="5"/>

            <Button
                android:id="@+id/b6_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="2"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:text="6"/>

            <Button
                android:id="@+id/bMenos_XBt"
                style="@style/CalculadoraBotonOperador"
                android:layout_row="2"
                android:layout_column="3"
                android:layout_columnWeight="1"
                android:text="−"/>

            <!-- ==================== FILA 4: 1 | 2 | 3 | + ==================== -->

            <Button
                android:id="@+id/b1_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="3"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="1"/>

            <Button
                android:id="@+id/b2_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="3"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="2"/>

            <Button
                android:id="@+id/b3_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="3"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:text="3"/>

            <Button
                android:id="@+id/bMas_XBt"
                style="@style/CalculadoraBotonOperador"
                android:layout_row="3"
                android:layout_column="3"
                android:layout_columnWeight="1"
                android:text="+"/>

            <!-- ==================== FILA 5: ± | 0 | . | = ==================== -->

            <Button
                android:id="@+id/bMasMenos_XBt"
                style="@style/CalculadoraBotonFuncion"
                android:layout_row="4"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:text="±"
                android:textSize="28sp"/>

            <Button
                android:id="@+id/b0_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="4"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:text="0"/>

            <Button
                android:id="@+id/bPunto_XBt"
                style="@style/CalculadoraBotonNumero"
                android:layout_row="4"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:text="."
                />

            <Button
                android:id="@+id/bIgual_XBt"
                style="@style/CalculadoraBotonIgual"
                android:layout_row="4"
                android:layout_column="3"
                android:layout_columnWeight="1"
                android:text="="
                />

        </GridLayout>

        <!-- ==================== BOTONES DE ACCIÓN INFERIOR ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Botón "Usar Resultado" - Solo visible cuando se llama desde un campo -->
            <Button
                android:id="@+id/usarResultado_XBt"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Usar Resultado"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="#4CAF50"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                android:elevation="4dp"
                android:textSize="14sp"
                />

            <!-- Botón Cerrar/Salir -->
            <Button
                android:id="@+id/salir_XBt"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Cerrar"
                android:textColor="#757575"
                android:background="@android:color/transparent"
                android:textAllCaps="false"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textSize="16sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>