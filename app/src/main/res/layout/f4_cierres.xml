<!--todo inicio-->
<androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="B_FRAGMENTS.F4_Cierres"
    android:id="@+id/constratinLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:rowCount="11"
    app:columnCount="1"
    app:layout_row="0"
    app:layout_column="0"
    android:background="#9FF1E9"
    android:visibility="visible"
    >

    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rowCount="2"
        app:columnCount="3"
        app:layout_row="2"
        app:layout_column="0"
        android:background="#58A5E3"
        >

        <TextView
            android:id="@+id/valorRecibidoResultadoCalculadorG1a_XTv"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="#FFEB3B"
            app:layout_row="0"
            app:layout_column="0"
            app:layout_gravity="center"

            />

        <TextView
            android:id="@+id/buscar_XTv"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_white_square"
            android:text="Tipos de cierre"
            android:textColor="#1B3AE4"
            android:textAlignment="center"
            android:textSize="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="5dp"
            app:layout_gravity="center_horizontal"
            app:layout_row="1"
            app:layout_column="0"
            />

        <Spinner
            android:id="@+id/consultaPorCuentaYFechaEnOtroFragment_XSp"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:background="@drawable/ic_spinner_arrow_down"
            android:textColor="#425DF6"
            android:textSize="22dp"
            android:layout_marginTop="4dp"
            />

        <RadioButton
            android:id="@+id/opcionSaleDeLaApp_XRb"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="Sale"
            android:textSize="0dp"
            android:layout_marginLeft="1dp"
            android:background="@drawable/ic_out"
            android:button="@drawable/bg_transparent"
            app:layout_row="1"
            app:layout_column="2"

            />

    </androidx.gridlayout.widget.GridLayout>

    <!--B inicio -->

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/areaOpcionesCierre_XGl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rowCount="2"
        app:columnCount="2"
        app:useDefaultMargins="true"
        app:layout_row="3"
        app:layout_column="0"
        app:layout_gravity="center_horizontal"
        android:background="#58A5E3"
        android:visibility="visible"
        android:layout_marginTop="2dp"
        >

        <RadioGroup
            android:id="@+id/OpcionesCierre_XRg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_gravity="center_horizontal"
            app:layout_row="0"
            app:layout_column="0"
            android:layout_marginLeft="10dp"
            >

            <RadioButton
                android:id="@+id/_1_opcionBackupDeReservaTransacciones_XRb"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginLeft="1dp"
                android:background="#58A5E3"
                android:text="1. Backup de reserva"
                android:textColor="@android:color/white"
                android:textSize="15dp"
                android:textStyle="bold"
                />

            <RadioButton
                android:id="@+id/_2_opcionAutonomoTransacciones_XRb"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="2. Interno todas las cuentas"
                android:layout_marginLeft="1dp"
                />

            <RadioButton
                android:id="@+id/_3_opcionTransaccionesAlgunasCuentas_XRb"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:background="#58A5E3"
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="3. Interno de algunas cuentas"

                />

            <RadioButton
                android:id="@+id/_4_1_opcionSincronizarBalance_desde_Sheets_XRb"
                android:text="4.1 Sincronizar Balance desde Sheets"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"

                />

            <RadioButton
                android:id="@+id/_4_2_opcion_Importar_Balance_desde_Sheets_XRb"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="4.2 Importar Balance desde Sheets"
                />

            <RadioButton
                android:id="@+id/_5_opcionRecuperarBackupTransacciones_XRb"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="5. Restaurar todas las transacciones"
               
                />

        </RadioGroup>


    </androidx.gridlayout.widget.GridLayout>

    <!--G inicio -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/area4SeeAccountsXGl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rowCount="11"
        app:columnCount="1"
        app:useDefaultMargins="true"
        app:layout_row="4"
        app:layout_column="0"
        app:layout_gravity="center_horizontal"
        android:background="#58A5E3"
        android:visibility="visible"
        >

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/numeroTransaccionesCierreCuentas_XGl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#9FF1E9"
            app:layout_row="2"
            app:layout_column="0"
            app:layout_gravity="center_horizontal"
            android:visibility="visible"
            app:rowCount="11"
            app:columnCount="4"
            app:useDefaultMargins="true"
            android:layout_marginLeft="8dp"

            >

            <TextView
                android:id="@+id/opcionActualCierre_XTv"
                android:layout_width="150dp"
                android:layout_height="35dp"
                android:background="#425DF6"
                android:text=""
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="14dp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/etiquetaNumeroDeTransaccionesCuentas"
                android:layout_width="100dp"
                android:layout_height="35dp"
                android:background="#425DF6"
                android:text="Transacciones"
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_column="2"
                app:layout_row="0"
                />

            <Button
                android:id="@+id/calculadoraLibre_XBt"
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="?attr/selectableItemBackground"
                android:text="🔢"
                android:textAllCaps="false"
                android:textColor="#1976D2"
                android:textSize="24sp"
                app:layout_column="3"
                app:layout_row="0"
                android:layout_marginTop="12dp"
                />


            <TextView
                android:id="@+id/mensajeInformativo_XTv"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:background="#425DF6"
                android:textAlignment="center"
                android:textColor="#F9F8FA"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_column="1"
                app:layout_row="0" />


        </androidx.gridlayout.widget.GridLayout>
    </androidx.gridlayout.widget.GridLayout>

    <!--G fin -->

    <!--I inicio -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/areaDocumento_XGl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rowCount="11"
        app:columnCount="1"
        app:useDefaultMargins="true"
        app:layout_row="8"
        app:layout_column="0"
        app:layout_gravity="center_horizontal"
        android:background="#9FF1E9"
        android:visibility="visible"
        >
        <LinearLayout
            android:id="@+id/envolventeEncabezadoItemLista_XLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1AA195"
            app:layout_constraintTop_toBottomOf="@+id/crudOptionsArea_XGl"
            android:orientation="horizontal"
            app:layout_row="1"
            app:layout_column="0"
            android:visibility="visible"
            app:layout_gravity="center_horizontal"
            >
            <!-- encabezado-->
            <TextView
                android:id="@+id/c1_documento_XTv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:background="@drawable/bg_green_square3"
                android:ellipsize="end"
                android:padding="5dp"
                android:singleLine="true"
                android:text="Doc." />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:background="@drawable/bg_green_square3"
                android:ellipsize="end"
                android:padding="5dp"
                android:singleLine="true"
                android:text="Item" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="@drawable/bg_green_square3"
                android:ellipsize="end"
                android:padding="5dp"
                android:singleLine="true"
                android:text="Cuenta" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_green_square3"
                android:ellipsize="end"
                android:padding="5dp"
                android:singleLine="true"
                android:text="Valor" />

        </LinearLayout>
        <!--I1 fin -->
        <LinearLayout
            android:id="@+id/envolventeEncabezado_XLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_row="2"
            app:layout_column="0"
            android:background="#9FF1E9"
            android:visibility="visible"
            app:layout_gravity="center_horizontal"
            >


            <ListView
                android:id="@+id/todasLasTransacciones_XLv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_centerHorizontal="true"
                android:background="#9FF1E9"
                android:listSelector="#F13F7C"
                android:scrollbarSize="15dp"
                android:scrollbarStyle="outsideOverlay"
                android:verticalScrollbarPosition="right"
                app:layout_column="0"
                app:layout_row="2"
                app:layout_gravity="center"
                android:layout_marginLeft="2dp"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/contenidoCalculadora_XTv"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AA195"
            />

        <LinearLayout
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_row="2"
            app:layout_column="0"
            android:visibility="visible"
            app:layout_gravity="center_horizontal"

            >

            <com.getbase.floatingactionbutton.FloatingActionsMenu
                android:id="@+id/menuFlotante_XFaM"
                android:layout_width="30dp"
                android:layout_height="200dp"
                app:fab_addButtonColorNormal="@color/colorAccent"
                app:fab_addButtonColorPressed="@color/colorAccent"
                android:layout_gravity="bottom|end"

                >

                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/disponible_XFaB"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    app:fab_colorNormal="@color/colorPrimaryDark"
                    app:fab_icon="@drawable/ic_save"
                    app:fab_size="mini" />


                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/comparteArchivoCSVTransacciones_XFaB"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    app:fab_colorNormal="@color/colorPrimaryDark"
                    app:fab_icon="@drawable/ic_share"
                    app:fab_size="mini" />

            </com.getbase.floatingactionbutton.FloatingActionsMenu>


        </LinearLayout>

        <!--I2 fin -->
    </androidx.gridlayout.widget.GridLayout>
    <!--I fin -->

</androidx.gridlayout.widget.GridLayout>
    <!--todo fin-->
