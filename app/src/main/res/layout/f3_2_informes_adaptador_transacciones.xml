<androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4863F8"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="B_FRAGMENTS.F3_1_VerInformePrincipal"
    app:rowCount="11"
    app:columnCount="1"
    android:layout_gravity="center_horizontal"
    >

    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rowCount="11"
        app:columnCount="3"
        app:layout_row="2"
        app:layout_column="0"
        app:useDefaultMargins="true"
        app:layout_gravity="center_horizontal"
        >

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowCount="2"
            app:columnCount="6"
            app:layout_row="1"
            app:layout_column="0"
            app:layout_gravity="center_horizontal"
            >

            <TextView
                android:id="@+id/valorRecibidoResultadoCalculadora_XTv"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="#FFEB3B"
                app:layout_row="0"
                app:layout_column="0"
                app:layout_gravity="center_horizontal"

                />

            <EditText
                android:id="@+id/buscar_XTv"
                android:layout_width="170dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_white_square"
                android:hint="Texto a busar"
                android:text=""
                android:textColor="#1B3AE4"
                android:textAlignment="center"
                android:textSize="20dp"
                app:layout_row="1"
                app:layout_column="0"
                />


            <Button
                android:id="@+id/cleanPasteQueryAccount_XChB"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_clean_paste"
                android:gravity="center"
                android:padding="0dp"
                app:layout_row="1"
                app:layout_column="1"
                android:textSize="24dp"
                />

            <Spinner
                android:id="@+id/consultaPorCuentaYFechaEnOtroFragment_XSp"
                android:layout_width="75dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_spinner_arrow_down"
                android:textColor="#425DF6"
                android:textSize="24dp"
                app:layout_row="1"
                app:layout_column="2"
            />


            <RadioButton
            android:id="@+id/opcionSaleDeLaApp_XRb"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:text=""
            android:textSize="24dp"
            android:layout_marginLeft="1dp"
            android:button="@drawable/bg_transparent"
            android:background="@drawable/ic_out"
            app:layout_row="1"
            app:layout_column="3"

            />

            <Button
                android:id="@+id/calculadoraLibre_XBt"
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="?attr/selectableItemBackground"
                android:text="🔢"
                android:textAllCaps="false"
                android:textColor="#1976D2"
                android:textSize="24sp"
                app:layout_row="1"
                app:layout_column="4"
                android:layout_marginTop="2dp"
                />

            <Button
                android:id="@+id/auditoriaClasificacion_XBt"
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_check"
                android:textAllCaps="false"
                app:layout_row="1"
                app:layout_column="5"
                android:layout_marginTop="2dp"
                />


        </androidx.gridlayout.widget.GridLayout>


        <LinearLayout
        android:id="@+id/envolventeEncabezado_XLl"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#1AA195"
        app:layout_constraintTop_toBottomOf="@+id/mensajeInformativo_XTv"
        android:orientation="horizontal"
        app:layout_row="3"
        app:layout_column="0"
        >

        <!-- encabezado-->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3.2"
            android:gravity="center"
            android:padding="5dp"
            android:text="Cuenta"
            android:textColor="#ffffff" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="5dp"
            android:text=""
            android:textColor="#ffffff" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:gravity="center"
            android:padding="5dp"
            android:text="Valor"
            android:textColor="#ffffff"
            />

        <TextView
            android:id="@+id/c10_Grupo1_XTv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/bg_green_square3"
            android:ellipsize="end"
            android:padding="5dp"
            android:singleLine="true"
            android:text="G1"
            android:textColor="#ffffff"

            />


        <TextView
            android:id="@+id/c11_Grupo2_XTv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/bg_green_square3"
            android:ellipsize="end"
            android:padding="5dp"
            android:singleLine="true"
            android:text="G2"
            android:textColor="#ffffff"

            />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/verTodasLasTransacciones_XLl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="horizontal"
        app:layout_row="4"
        app:layout_column="0"

        >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Otros elementos que desees incluir antes del ListView -->

                <ListView
                    android:id="@+id/todasLasTransacciones_XLv"
                    android:layout_width="match_parent"
                    android:layout_height="700dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginEnd="2dp"
                    android:background="#F1B761"
                    android:listSelector="#F2E254"
                    android:scrollbarSize="20dp"
                    android:verticalScrollbarPosition="right" />

                <!-- Otros elementos que desees incluir después del ListView -->

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    </androidx.gridlayout.widget.GridLayout>


</androidx.gridlayout.widget.GridLayout>