             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#F3E5F5"
             android:padding="6dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:textSize="14sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="120dp"
