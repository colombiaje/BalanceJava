<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context="B_FRAGMENTS.F5_1_Indicadores">

   <!-- ENCABEZADO -->
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="40dp"
       android:orientation="horizontal"
       android:background="#673AB7"
       android:gravity="center_vertical"
       android:paddingLeft="8dp"
       android:paddingRight="8dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="INDICADORES FINANCIEROS"
          android:textColor="@android:color/white"
          android:textSize="16sp"
          android:textStyle="bold"
          android:gravity="center"/>

      <Button
          android:id="@+id/calculadoraLibre_XBt"
          android:layout_width="40dp"
          android:layout_height="35dp"
          android:background="?attr/selectableItemBackground"
          android:text="🔢"
          android:textAllCaps="false"
          android:textColor="#1976D2"
          android:textSize="24sp"
          app:layout_column="3"
          app:layout_row="0"
          />

      <ImageButton
          android:id="@+id/salidaEsteFragment_XBt"
          android:layout_width="30dp"
          android:layout_height="30dp"
          android:background="@drawable/ic_out"
          android:contentDescription="Cerrar"/>
   </LinearLayout>

   <!-- PRESUPUESTO MENSUAL: único valor editable; todo lo demás se deriva de él -->
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       android:background="#EDE7F6"
       android:gravity="center_vertical"
       android:padding="6dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Presupuesto mensual"
          android:textSize="13sp"
          android:textStyle="bold"/>

      <EditText
          android:id="@+id/editPresupuestoTotal_XEt"
          android:layout_width="90dp"
          android:layout_height="34dp"
          android:background="#FFFFFF"
          android:textSize="14sp"
          android:gravity="center"
          android:inputType="number"
          android:hint="1150"/>

      <ImageButton
          android:id="@+id/btnGuardarPresupuesto_XBt"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginStart="4dp"
          android:background="#4CAF50"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_menu_save"
          android:contentDescription="Guardar"/>
   </LinearLayout>

   <!-- CABECERA DE TABLA — 4 columnas de $ compartidas por las 3 filas de dato -->
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       android:background="#9575CD"
       android:padding="6dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text=" "
          android:textSize="10sp"/>

      <TextView
          android:layout_width="62dp"
          android:layout_height="wrap_content"
          android:text="Transcur."
          android:textColor="@android:color/white"
          android:textSize="10sp"
          android:textStyle="bold"
          android:gravity="center"/>

      <TextView
          android:layout_width="62dp"
          android:layout_height="wrap_content"
          android:text="Diario"
          android:textColor="@android:color/white"
          android:textSize="10sp"
          android:textStyle="bold"
          android:gravity="center"/>

      <TextView
          android:layout_width="62dp"
          android:layout_height="wrap_content"
          android:text="Por transc."
          android:textColor="@android:color/white"
          android:textSize="10sp"
          android:textStyle="bold"
          android:gravity="center"/>

      <TextView
          android:layout_width="62dp"
          android:layout_height="wrap_content"
          android:text="Mes proy."
          android:textColor="@android:color/white"
          android:textSize="10sp"
          android:textStyle="bold"
          android:gravity="center"/>

   </LinearLayout>

   <!-- SCROLL DE CONTENIDO -->
   <ScrollView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_weight="0"
       android:fillViewport="true">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

         <!-- FILA "Días": cuántos días de calendario representa cada columna -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#D1C4E9"
             android:padding="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Días"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/valorDiasTranscurrido_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorDiasDiario_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorDiasPorTranscurrir_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorDiasMesTotal_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA "Presupuesto": la meta, prorrateada al día -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#F3E5F5"
             android:padding="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Presupuesto"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/valorPresupuestoTranscurrido_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorPresupuestoDiario_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorPresupuestoPorTranscurrir_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorPresupuestoMesTotal_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA "Depurado" — tocar el nombre abre el detalle de prorrateables -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#F3E5F5"
             android:padding="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

               <TextView
                   android:id="@+id/VerDetalleProrrateables_XTv"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Depurado"
                   android:textSize="13sp"
                   android:textStyle="bold"
                   android:textColor="#4A148C"/>

               <ImageButton
                   android:id="@+id/btnVerDetalleProrrateables_XBt"
                   android:layout_width="18dp"
                   android:layout_height="18dp"
                   android:layout_marginStart="4dp"
                   android:background="@drawable/ic_ver_info"
                   android:scaleType="fitCenter"
                   android:contentDescription="Ver detalle"/>
            </LinearLayout>

            <TextView
                android:id="@+id/valorDepuradoTranscurrido_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorDepuradoDiario_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorDepuradoPorTranscurrir_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorDepuradoMesProyectado_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA "Vs Presupuesto" (Depurado) — el color YA dice si excede o no -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#EDE7F6"
             android:padding="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vs Presupuesto"
                android:textSize="12sp"
                android:textStyle="italic"/>

            <TextView
                android:id="@+id/valorVsDepuradoTranscurrido_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorVsDepuradoDiario_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorVsDepuradoPorTranscurrir_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorVsDepuradoMesProyectado_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA "Contable" — tocar el nombre lleva a las transacciones de la cuenta -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#F3E5F5"
             android:padding="6dp">

            <TextView
                android:id="@+id/irALaCuentaContable_XTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contable"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4A148C"/>

            <TextView
                android:id="@+id/valorContableTranscurrido_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorContableDiario_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorContablePorTranscurrir_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorContableMesProyectado_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA "Vs Presupuesto" (Contable) -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#EDE7F6"
             android:padding="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vs Presupuesto"
                android:textSize="12sp"
                android:textStyle="italic"/>

            <TextView
                android:id="@+id/valorVsContableTranscurrido_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorVsContableDiario_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorVsContablePorTranscurrir_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/valorVsContableMesProyectado_XTv"
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

         </LinearLayout>

         <!-- SEPARADOR BALANCE GENERAL -->
         <TextView
             android:layout_width="match_parent"
             android:layout_height="35dp"
             android:text="BALANCE GENERAL"
             android:background="#512DA8"
             android:textColor="@android:color/white"
             android:textSize="15sp"
             android:textStyle="bold"
             android:gravity="center"
             android:layout_marginTop="8dp"/>

         <!-- FILA 10: Suma Activo Exigible -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#F3E5F5"
             android:padding="6dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="14sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Suma Activo Exig."
                android:textSize="14sp"
                android:paddingLeft="4dp"/>

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 4: Depurado (era "-") -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 5: Contable -->
            <TextView
                android:id="@+id/valorActivoExigible_XTv"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA 11: Suma Pasivo Exigible -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#E1BEE7"
             android:padding="6dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="2"
                android:textSize="14sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Suma Pasivo Exig."
                android:textSize="14sp"
                android:paddingLeft="4dp"/>

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 4: Depurado (era "-") -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 5: Contable -->
            <TextView
                android:id="@+id/valorPasivoExigible_XTv"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA 12: Ahorro o deuda -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#F3E5F5"
             android:padding="6dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="3"
                android:textSize="14sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Ahorro o deuda"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingLeft="4dp"/>

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 4: Depurado (era "-") -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 5: Contable -->
            <TextView
                android:id="@+id/valorAhorroODeuda_XTv"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"/>

         </LinearLayout>

      </LinearLayout>
   </ScrollView>

</LinearLayout>