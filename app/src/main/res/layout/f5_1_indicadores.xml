                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 4: Depurado -->
            <TextView
                android:id="@+id/valorPromDiaPorEjecDepurado_XTv"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 5: Contable -->
            <TextView
