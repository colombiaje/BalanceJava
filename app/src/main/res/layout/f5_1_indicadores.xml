                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 4: Depurado -->
            <TextView
                android:id="@+id/valorEjecutadoDepurado_XTv"
                android:layout_width="80dp"
