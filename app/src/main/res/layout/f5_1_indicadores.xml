                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 4: Depurado -->
            <TextView
                android:id="@+id/valorProyHoyDepurado_XTv"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 5: Contable -->
            <TextView
                android:id="@+id/valorProyHoyContable_XTv"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

         </LinearLayout>

         <!-- FILA 8: Prom. día ayer -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="#F3E5F5"
             android:padding="6dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="8"
                android:textSize="14sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Prom. día ayer"
                android:textSize="14sp"
                android:paddingLeft="4dp"/>

            <TextView
                android:id="@+id/valorDiasAyer_XTv"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- COL 4: Depurado -->
            <TextView
                android:id="@+id/valorPromDiaAyerDepurado_XTv"
                android:layout_width="80dp"
