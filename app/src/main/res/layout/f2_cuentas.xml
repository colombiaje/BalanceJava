                    android:layout_marginLeft="1dp"
                    android:layout_gravity="center_vertical"
                    />

                <RadioButton
                    android:id="@+id/opcionSaleDeLaApp_XRb"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="Sale de la App"
                    android:textSize="0dp"
                    android:layout_marginLeft="1dp"
                    android:button="@drawable/bg_transparent"
                    android:background="@drawable/ic_out"
                    android:layout_gravity="center_vertical"

                    />
                <RadioButton
                    android:id="@+id/outAccounts_XRb"
                    android:layout_width="45dp"
                    android:layout_height="35dp"
                    android:text="Sale App"
                    android:textSize="15dp"
                    android:layout_marginLeft="1dp"
                    android:button="@drawable/bg_transparent"
                    android:background="#A1CA26"
                    android:layout_gravity="center_vertical"
                    />

                <Button
                    android:id="@+id/calculadoraLibre_XBt"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
