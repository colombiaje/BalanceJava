                    android:textAllCaps="false"
                    android:textColor="#1976D2"
                    android:textSize="24sp"

                    />

            </LinearLayout>


        <!-- area 2 -->


    <!-- area 3 -->
    <androidx.gridlayout.widget.GridLayout

        android:id="@+id/area2crud_XGl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="6dp"
        android:background="#F25087"
        android:visibility="visible"
        app:columnCount="5"
        app:layout_column="0"
        app:layout_gravity="left"
        app:layout_row="2"
        app:rowCount="13"
        app:useDefaultMargins="true">

        <TextView
            android:id="@+id/titleNewXTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:background="@android:color/holo_purple"
            android:gravity="center_horizontal"
            android:text="Nueva Cuenta"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/white"
            android:textSize="24dp"
            app:layout_column="1"
            app:layout_columnSpan="3"
            app:layout_gravity="center_horizontal"
            app:layout_row="1"

            />

        <TextView
            android:id="@+id/titleModifyXTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:background="@android:color/holo_purple"
            android:gravity="center_horizontal"
            android:text="Modificar cuenta"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/white"
            android:textSize="24dp"
            app:layout_column="1"
            app:layout_columnSpan="3"
            app:layout_gravity="center_horizontal"
            app:layout_row="2"

            />

        <LinearLayout
            android:id="@+id/transacciones_XLL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_column="1"
            app:layout_columnSpan="3"
            app:layout_gravity="center_horizontal"
            app:layout_row="3">

            <TextView
                android:id="@+id/cuentaConTransacciones_XTv"
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="2dp"
                android:background="#E91E63"
                android:ellipsize="none"
                android:gravity="top|start"
                android:lines="2"
                android:maxLines="4"
                android:padding="8dp"
                android:text=""
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@android:color/white"
                android:textSize="18dp" />

            <!--<CheckBox
                    android:id="@+id/verTransacciones_XChB"
                    android:layout_width="150dp"
                    android:layout_height="25dp"
                    android:background="#A1CA26"
                    android:text="Ver transacciones"
                    android:lines="2"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@android:color/white"
                    android:textSize="18dp"
                    android:layout_gravity="center_vertical"
                    />-->

        </LinearLayout>

        <GridView
            android:id="@+id/verCuentaConTransacciones_XGV"
            android:layout_width="475dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:background="@drawable/bg_white_square"
            android:columnWidth="350dp"
            android:gravity="center_horizontal"
            android:horizontalSpacing="5mm"
            android:listSelector="#F2E254"
            android:numColumns="auto_fit"
            android:scrollIndicators="left"
            android:scrollbarSize="30dp"
            android:scrollbars="vertical"
            android:textAlignment="center"
            android:verticalScrollbarPosition="right"
            android:verticalSpacing="001mm"
            android:visibility="gone"
            app:layout_column="1"
            app:layout_columnSpan="3"
            app:layout_gravity="center_horizontal"
            app:layout_row="4" />

        <TextView

            android:layout_width="70dp"
            android:layout_height="25dp"
            android:background="@drawable/bg_turquoise_green_square"
            android:text="Emular"
            android:textColor="#1B3AE4"
            android:textSize="18dp"
            app:layout_column="1"
            app:layout_gravity="center"
            app:layout_row="5" />

        <AutoCompleteTextView
            android:id="@+id/emulateAttributesAccount_XAct"
            android:layout_width="260dp"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_white_square"
            android:hint="Texto a busar"
            android:text=""
            android:textAlignment="center"
            android:textColor="#1B3AE4"
            android:textSize="20dp"
            app:layout_column="2"
            app:layout_columnSpan="3"
            app:layout_row="5"

            />

        <CheckBox
            android:id="@+id/copyCuentaABuscarXChb"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/ic_clean_paste"
            android:button="@null"
            android:textSize="25dp"
            android:textStyle="bold"
            app:layout_column="3"
            app:layout_gravity="center"
            app:layout_row="5"

            />

        <TextView

            android:id="@+id/item"
            android:layout_width="70dp"
            android:layout_height="25dp"
            android:background="@android:color/holo_purple"
            android:text="Item"
            android:textColor="@android:color/white"
            android:textSize="18dp"
            app:layout_column="1"
            app:layout_gravity="center"
            app:layout_row="6" />

        <TextView

            android:id="@+id/item_XTv"
            android:layout_width="70dp"
            android:layout_height="25dp"
            android:background="#F4D7F5"
            android:text="Item"
            android:textAlignment="center"
            android:textColor="@android:color/black"
            android:textSize="18dp"
            app:layout_column="2"
            app:layout_gravity="center"
            app:layout_row="6" />

        <TextView

            android:id="@+id/vTnombreNuevaCuenta"
            android:layout_width="70dp"
            android:layout_height="25dp"
            android:background="@android:color/holo_purple"
            android:text="Nombre"
            android:textColor="@android:color/white"
            android:textSize="18dp"
            app:layout_column="1"
            app:layout_gravity="center"
            app:layout_row="7" />

        <AutoCompleteTextView
            android:id="@+id/account_XAct"
            android:layout_width="260dp"
            android:layout_height="30dp"
            android:background="#F4D7F5"
            android:singleLine="true"
            android:textSize="18dp"
            app:layout_column="2"
            app:layout_row="7" />

        <CheckBox
            android:id="@+id/copyPasteNombreEnNueva_XChb"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/ic_clean_paste"
            android:button="@null"
            android:textSize="25dp"
            android:textStyle="bold"
            app:layout_column="3"
            app:layout_gravity="center"
            app:layout_row="7"

            />


        <TextView
            android:id="@+id/vTgrupo"
            android:layout_width="70dp"
            android:layout_height="25dp"
            android:background="@android:color/holo_purple"
            android:text="Grupo 1"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/white"
            android:textSize="18dp"
            app:layout_column="1"
            app:layout_gravity="center"
            app:layout_row="8" />


        <Spinner
            android:id="@+id/grupo1CuentaNueva_XSp"
            android:layout_width="260dp"
            android:layout_height="40dp"
            android:background="#F4D7F5"
            android:scrollbarSize="18dp"
            app:layout_column="2"
            app:layout_row="8"

            />

        <TextView
            android:id="@+id/grupo2NuevaCuenta"
            android:layout_width="70dp"
            android:layout_height="25dp"
            android:background="@android:color/holo_purple"
            android:text="Grupo 2"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/white"
            android:textSize="18dp"
            app:layout_column="1"
            app:layout_gravity="center"
            app:layout_row="9" />

        <Spinner
            android:id="@+id/grupo2CuentaNueva_XSp"
            android:layout_width="260dp"
            android:layout_height="40dp"
            android:background="#F4D7F5"
            android:scrollbarSize="18dp"
            app:layout_column="2"
            app:layout_row="9"

            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_column="0"
            app:layout_columnSpan="4"
            app:layout_gravity="center_horizontal"
            app:layout_row="10">

            <Button
                android:id="@+id/cleanFieldsAccount_XBt"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_clean"
                app:layout_gravity="center_horizontal"

                />

            <Button
                android:id="@+id/clickSave_XBt"
                android:layout_width="120dp"
                android:layout_height="35dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_green_square"
                android:text="Guardar"
                android:textColor="@android:color/black"
                android:textSize="15dp"
                app:layout_gravity="center" />


            <Button
                android:id="@+id/clickUpdate_XBt"
                android:layout_width="120dp"
                android:layout_height="35dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_green_square"
                android:text="Modificar"
                android:textColor="@android:color/black"
                android:textSize="15dp"
                app:layout_gravity="center" />

            <Button
                android:id="@+id/clickDeleteXBt"
                android:layout_width="103dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_turquoise_green_square"
                android:text="Eliminar"
                android:textColor="@android:color/black"
                android:textSize="15dp"
                app:layout_gravity="center" />


        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_column="0"
            app:layout_row="11">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/alertaAlEscribirEnModificar_XTiL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="hint"
                android:visibility="gone"
                app:layout_column="0"
                app:layout_row="11"

                tools:layout_editor_absoluteX="1dp" />
        </com.google.android.material.textfield.TextInputLayout>


    </androidx.gridlayout.widget.GridLayout>

    <LinearLayout
            android:id="@+id/area3AttributesXLY"
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_row="3"
            app:layout_column="0"
            app:layout_gravity="center_horizontal"
            >

            <LinearLayout
                android:layout_width="500dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <TextView
                    android:id="@+id/tituloConsultarDEtallesCuentaXTV"
                    android:layout_width="150dp"
                    android:layout_height="40dp"
                    android:background="@android:color/holo_purple"
                    android:text="Atributos cuenta: "
                    android:textAlignment="center"
                    android:textColor="@android:color/white"
                    android:textSize="18dp"
                    app:layout_gravity="left"
                    android:layout_marginLeft="5dp"
                    />

                <Spinner
                    android:id="@+id/cuentasOrdenAzParaVistaDetalleCuenta_XSp"
                    android:layout_width="244dp"
                    android:layout_height="40dp"
                    android:background="#A1CA26"
                    android:textColor="#EA3F79"
                    android:textSize="18dp"
                    app:layout_gravity="left"
                    android:layout_marginTop="5dp"
                    />

            </LinearLayout>


            <TableLayout
                android:id="@+id/atributos_XTL"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:stretchColumns="1"
                android:background="@drawable/bg_turquoise_green_square"
                android:divider="@android:color/darker_gray"
                android:showDividers="middle"
                android:layout_marginTop="5dp"
                android:visibility="visible"
                >
            <!-- Cabecera (opcional, puedes agregarla dinámicamente en el código también) -->
            <TableRow
                android:background="#cccccc"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atributo"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valor"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:gravity="center" />
            </TableRow>

        </TableLayout>

        </LinearLayout>

        <!-- area 4 -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/area4SeeAccountsXGl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:rowCount="11"
        app:columnCount="1"
        app:useDefaultMargins="true"
        app:layout_row="4"
        app:layout_column="0"
        app:layout_gravity="center_horizontal"
        android:background="#58A5E3"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        >

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_row="1"
            app:layout_column="0"
            android:gravity="center_horizontal"
            android:layout_marginRight="2dp"
            >

            <TextView
                android:id="@+id/opcionActualCierre_XTv"
                android:layout_width="160dp"
                android:layout_height="35dp"
                android:background="#425DF6"
                android:text="Cantidad"
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="14dp"
                android:textStyle="bold"
                android:layout_marginRight="2dp"
                android:layout_marginLeft="80dp"

                />


            <TextView
                android:id="@+id/mensajeInformativo_XTv"
                android:layout_width="50dp"
                android:layout_height="35dp"
                android:background="#425DF6"
                android:textAlignment="center"
                android:textColor="#F9F8FA"
                android:textSize="14dp"
                android:textStyle="bold"
                android:layout_marginRight="2dp"

                />

            <TextView
                android:id="@+id/etiquetaNumeroDeTransaccionesCuentas"
                android:layout_width="100dp"
                android:layout_height="35dp"
                android:background="#425DF6"
                android:text=" cuentas "
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="14dp"
                android:textStyle="bold"

                />

        </LinearLayout>

        <ListView
            android:id="@+id/todasLasCuentas_XLv"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_centerHorizontal="true"
            android:background="#7FCBED"
            android:listSelector="#F13F7C"
            android:scrollbarSize="15dp"
            android:scrollbarStyle="outsideOverlay"
            android:verticalScrollbarPosition="right"
            app:layout_row="3"
            app:layout_column="0"
            app:layout_gravity="center_horizontal"
            android:layout_marginLeft="2dp"
            />

    </androidx.gridlayout.widget.GridLayout>

    <!-- area 5 -->
    <LinearLayout
        android:id="@+id/area5BackupsClosingXLL"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_row="5"
        app:layout_column="0"
        android:visibility="visible"
        app:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        >

        <TextView
            android:id="@+id/areaTituloBackupsYCierreXTv"
            android:layout_width="300dp"
            android:layout_height="25dp"
            android:background="@android:color/holo_purple"
            android:text="Backups y cierre: "
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="18dp"
            app:layout_gravity="center"
            android:visibility="visible"
            android:layout_gravity="center_horizontal"
            />

            <RadioGroup
            android:id="@+id/OpcionesCierre_XRg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_horizontal"
            >
                <RadioButton
                android:id="@+id/_11_opcionBackupDeReservaCuentas_XRb"
                android:layout_width="300dp"
                android:layout_height="33dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="1. Backup"
                 />

                <RadioButton
                android:id="@+id/_2_1_opcionSincronizarCuentasDesdeSheets_XRb"
                android:layout_width="300dp"
                android:layout_height="33dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="2.1 Sincronizar Cuentas con Sheets"
                    />


                <RadioButton
                android:id="@+id/_2_2_opcionImportarCuentasGoogleSheets_XRb"
                android:layout_width="300dp"
                android:layout_height="33dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="2.2 Importar de Sheets"
                  />

            <RadioButton
                android:id="@+id/_31_opcionRestaurarCuentasBackup_XRb"
                android:layout_width="300dp"
                android:layout_height="33dp"
                android:background="#58A5E3"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:text="3. Restaurar backup"
                 />

                </RadioGroup>

    </LinearLayout>


</androidx.gridlayout.widget.GridLayout>
