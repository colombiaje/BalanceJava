                android:layout_height="50dp"
                android:orientation="horizontal"
                tools:ignore="MissingConstraints"
                android:visibility="visible"
                android:layout_marginLeft="15dp"
                >

                <CheckBox
                    android:id="@+id/seeNewXChB"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_add_cuenta"
                    android:text=""
                    android:textColor="#425DF6"
                    android:textSize="15dp"
                    android:layout_marginRight="2dp"
                    android:button="@drawable/bg_transparent"
                    />

                <CheckBox
                    android:id="@+id/seeModifyXChB"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_edit_cuentas2"
                    android:text=""
                    android:textColor="#425DF6"
                    android:textSize="15dp"
                    android:layout_marginRight="2dp"
                    android:button="@drawable/bg_transparent"
                    />

                <CheckBox
                    android:id="@+id/verCuentas_XChb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text=""
