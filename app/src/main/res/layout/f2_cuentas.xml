                    app:layout_row="1"
                    android:background="@drawable/ic_list_cuentas"
                    android:layout_marginRight="2dp"
                    android:button="@drawable/bg_transparent"
                    />

                <CheckBox
                    android:id="@+id/verBackupsYCierres_XChb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text=""
                    android:textSize="12dp"
                    android:lines="2"
                    app:layout_column="0"
                    app:layout_row="1"
                    android:background="@drawable/ic_cierre_cuentas"
                    android:layout_marginRight="2dp"
                    android:button="@drawable/bg_transparent"
                    />


                <Spinner
                    android:id="@+id/consultaPorCuentaYFechaEnOtroFragment_XSp"
